# Tüm metin dosyaları depoda ve çalışma dizininde LF (.editorconfig ile uyumlu; Windows'ta dotnet format için gerekli)
* text=auto eol=lf

# Windows'a özgü betikler
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# İkili dosyalar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
