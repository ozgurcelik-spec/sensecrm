@@ -0,0 +1,97 @@
+using System.Collections.Frozen;
+using System.Linq.Expressions;
+using System.Reflection;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Metadata.Builders;
+
+namespace Sense.Crm.Shared.Infrastructure.Persistence.RecordScope;
+
+/// <summary>Bir kaynak için okuma/yazma kümesi. Diziler kullanıcı başına bir kez üretilir ve paylaşılır.</summary>
+public sealed record ResourceScope(bool ReadAll, Guid[] ReadOwners, bool WriteAll, Guid[] WriteOwners, bool IncludeUnowned)
+{
+    public static readonly ResourceScope None = new(false, [], false, [], false);
+
+    public static readonly ResourceScope All = new(true, [], true, [], true);
+}
+
+/// <summary>(kullanıcı, kiracı) kapsam anlık görüntüsü. Bilinmeyen kaynak = hiçbir şey (kapalı-başarısız).</summary>
+public sealed class RecordScopeSnapshot(Guid userId, bool unrestricted, IDictionary<string, ResourceScope> resources)
+{
+    private readonly FrozenDictionary<string, ResourceScope> _resources = resources.ToFrozenDictionary(StringComparer.Ordinal);
+
+    public Guid UserId { get; } = userId;
+
+    public bool Unrestricted { get; } = unrestricted;
+
+    public ResourceScope Get(string resource) => Unrestricted ? ResourceScope.All : _resources.GetValueOrDefault(resource, ResourceScope.None);
+
+    public static readonly RecordScopeSnapshot System = new(Guid.Empty, true, new Dictionary<string, ResourceScope>());
+
+    public static readonly RecordScopeSnapshot Deny = new(Guid.Empty, false, new Dictionary<string, ResourceScope>());
+}
+
+/// <summary>
+/// <c>TenantContext</c> deseninde AsyncLocal bağlam. Filtre ifadesi <b>DbContext örneğini ilk argüman olarak</b> geçirir; EF bu çağrıyı sorgu derlenirken değil
+/// HER YÜRÜTMEDE değerlendirir (H0 spike: statik çağrı, bağlam argümanı olmadan, ilk kullanıcının kapsamını önbelleğe gömer — kullanıcılar arası sızıntı).
+/// </summary>
+public static class RecordScopeContext
+{
+    private static readonly AsyncLocal<RecordScopeSnapshot?> Current = new();
+
+    /// <summary>true: kurulmamış bağlam = hiçbir şey (API sürecinde önerilen); false: sınırsız (Worker/Migrator/test).</summary>
+    public static bool FailClosedWhenUnset { get; set; }
+
+    private static RecordScopeSnapshot Effective => Current.Value ?? (FailClosedWhenUnset ? RecordScopeSnapshot.Deny : RecordScopeSnapshot.System);
+
+    public static RecordScopeSnapshot Snapshot => Effective;
+
+    public static IDisposable Use(RecordScopeSnapshot snapshot)
+    {
+        var previous = Current.Value;
+        Current.Value = snapshot;
+        return new Restorer(previous);
+    }
+
+    public static IDisposable UseSystem() => Use(RecordScopeSnapshot.System);
+
+    // Filtre giriş noktaları: ilk argüman (DbContext) yalnız EF'e "bu çağrı bağlama bağlı, her yürütmede değerlendir" der.
+    public static bool ReadAll(DbContext context, string resource) => Effective.Get(resource).ReadAll;
+
+    public static Guid[] ReadOwners(DbContext context, string resource) => Effective.Get(resource).ReadOwners;
+
+    public static bool IncludeUnowned(DbContext context, string resource) => Effective.Get(resource).IncludeUnowned;
+
+    private sealed class Restorer(RecordScopeSnapshot? previous) : IDisposable
+    {
+        public void Dispose() => Current.Value = previous;
+    }
+}
+
+/// <summary>Kaynak yapılandırmasında tek satır: <c>b.HasRecordScope("lead", x =&gt; x.OwnerUserId)</c>. Filtreyi <see cref="ModuleDbContext"/> taban döngüsü kurar.</summary>
+public static class RecordScopeModelExtensions
+{
+    public const string FilterName = "RecordScope";
+    public const string FactoryAnnotation = "Sense:RecordScopeFilterFactory";
+
+    private static readonly MethodInfo Contains = typeof(Enumerable).GetMethods(BindingFlags.Public | BindingFlags.Static)
+        .Single(m => m.Name == nameof(Enumerable.Contains) && m.GetParameters().Length == 2).MakeGenericMethod(typeof(Guid));
+
+    /// <summary>Bağlam ifadesi (<c>Expression.Constant(this)</c>) verilince filtre lambda'sını üretir.</summary>
+    public delegate LambdaExpression FilterFactory(Expression context);
+
+    public static EntityTypeBuilder<T> HasRecordScope<T>(this EntityTypeBuilder<T> builder, string resource, Expression<Func<T, Guid>> owner)
+        where T : class
+    {
+        builder.HasAnnotation(FactoryAnnotation, (FilterFactory)(ctx => Expression.Lambda<Func<T, bool>>(
+            Expression.OrElse(Call(ctx, nameof(RecordScopeContext.ReadAll), resource), Expression.Call(Contains, Call(ctx, nameof(RecordScopeContext.ReadOwners), resource), owner.Body)),
+            owner.Parameters[0])));
+        return builder;
+    }
+
+    /// <summary><c>IgnoreQueryFilters([RecordScope])</c> sarmalı: kiracı + silinmiş filtreleri kalır. Yalnız onaylı envanterde çağrılır.</summary>
+    public static IQueryable<T> IgnoreRecordScope<T>(this IQueryable<T> query)
+        where T : class => query.IgnoreQueryFilters([FilterName]);
+
+    private static MethodCallExpression Call(Expression ctx, string method, string resource) =>
+        Expression.Call(typeof(RecordScopeContext).GetMethod(method, [typeof(DbContext), typeof(string)])!, ctx, Expression.Constant(resource));
+}
