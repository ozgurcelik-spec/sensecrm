{
  "uid": "crm-security",
  "title": "CRM - Security signals",
  "description": "Login failures, lockouts, refresh-token reuse, rate limiting and authorization outcomes. Aggregate counters only: no user, tenant or address labels.",
  "tags": [
    "crm"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "CRM",
      "tags": [
        "crm"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": "",
      "showInDropdown": true
    }
  ],
