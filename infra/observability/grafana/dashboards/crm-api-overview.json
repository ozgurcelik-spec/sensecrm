    {
      "type": "stat",
      "title": "Targets up (api / worker)",
      "description": "Scrape targets that answer. Expected: 1 api + 1 worker (more with replicas).",
      "datasource": {
        "type": "prometheus",
        "uid": "crm-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "count(up{job=~\"crm-api|crm-worker\"} == 1)",
          "legendFormat": "",
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
