      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "crm-prometheus"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"crm-api\",http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"crm-api\"}[$__rate_interval])), 0.001)",
          "legendFormat": "",
          "range": true
        }
      ],
      "id": 4,
