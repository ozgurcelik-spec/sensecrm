# Rendered by the nginx-unprivileged entrypoint (envsubst): ${API_UPSTREAM}, ${DNS_RESOLVER}, ${TRUSTED_PROXY_CIDR}.
#
# TLS is NOT terminated here. Put an external reverse proxy / load balancer in front (see deploy/README + docs/operations/runbook.md);
# it must send X-Forwarded-For and X-Forwarded-Proto.

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $forwarded_proto $hsts {
    https   "max-age=31536000; includeSubDomains";
    default "";
}

server {
    listen       8080;
    server_name  _;
    server_tokens off;

    root  /usr/share/nginx/html;
    index index.html;

    # Client address: trust X-Forwarded-For only when the connection comes from the configured proxy network.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header   X-Forwarded-For;
    real_ip_recursive on;

    # Re-resolve the api service at run time so an api container that was recreated (new IP) is picked up without an nginx reload.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    client_max_body_size 20m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        application/manifest+json
        image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # Liveness of this container only (no upstream call).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API reverse proxy. The api container is reachable only on the internal network; the browser talks to the same origin.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Only ONE address is forwarded: the real client as determined above (the API trusts exactly one hop).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_hide_header X-Powered-By;
        # The API sets its own security headers (nosniff, DENY, no-referrer, ...) and its own Cache-Control (auth/* no-store, config 60 s);
        # declaring any add_header here stops nginx from also inheriting the server-level set, so nothing is duplicated.
        add_header Strict-Transport-Security $hsts always;
    }

    # Hashed build assets (Vite appends a content hash to the file name) can be cached forever; a new deploy ships new names.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Translation files keep fixed names (i18next fetches /locales/<lng>/<ns>.json): always revalidate (cheap 304 via ETag).
    location ^~ /locales/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # index.html must always be revalidated so a new deploy is picked up on the next load.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA history fallback: unknown paths are handled by the router on the client.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
