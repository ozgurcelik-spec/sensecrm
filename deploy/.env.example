# CRM production stack - environment template. Copy to deploy/.env (it is git-ignored) and fill in the blanks, or let
# deploy/generate-secrets.ps1 (Windows PowerShell 5.1+) / deploy/generate-secrets.sh (Linux) do it.
#
# Blank secrets are intentional: docker-compose.prod.yml refuses to start while one is empty, so a copied template can never run
# with a well-known password. Do NOT put quotes, ';' or spaces into passwords (they are embedded in connection strings);
# the generators produce 32 alphanumeric characters.

# ---- identity of the installation ----------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=crm-prod
# Public host name(s) of the SPA as users type it (';' separated). The API rejects other Host headers (400 Invalid Hostname), which
# blocks Host-header spoofing/cache poisoning: list ONLY your real public names (e.g. crm.company.local;crm.company.com). Do NOT use
# '*' or a wildcard like *.company.com. 'localhost' is appended by docker-compose.prod.yml for the container health check only; do not
# add it here, and never add an IP address or a name you do not control.
ALLOWED_HOSTS=crm.example.local
# Image tag to run (crm-api|crm-worker|crm-migrator|crm-web:<CRM_VERSION>); CRM_REGISTRY is a prefix incl. trailing slash, e.g. registry.company.local/crm/
CRM_VERSION=latest
CRM_REGISTRY=

# ---- published port (the ONLY one) ---------------------------------------------------------------------------------------
# 127.0.0.1 = a reverse proxy / TLS terminator on the same host. Use the host's private IP (or 0.0.0.0 behind a firewall) when the
# load balancer runs on another machine.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Address/CIDR of the reverse proxy / load balancer whose X-Forwarded-For header nginx trusts to learn the real client IP (rate limits,
# audit trail). Default 127.0.0.1/32 = loopback only = NOTHING is trusted: nginx ignores X-Forwarded-For, so a client can never spoof
# its address. Consequence: without a trusted proxy the client address is whatever connects to the published port, i.e. for a proxy
# on the same host (or Docker Desktop) the frontend network gateway, and the per-IP rate limits then key on that one address.
# Set it explicitly when a proxy/LB is in front:
#   same-host Caddy/nginx (WEB_BIND=127.0.0.1):  the frontend network gateway = first address of FRONTEND_SUBNET, e.g. 10.213.78.1/32
#                                                (check: `docker compose logs web` shows the address your proxy connects from)
#   LB on another machine (WEB_BIND=<private IP>): the LB's address, e.g. 10.0.5.10/32 (firewall WEB_PORT to the LB only)
# NEVER put a wide range here (the frontend subnet, 0.0.0.0/0) while WEB_BIND is 0.0.0.0 / a routable IP: any client could then spoof it.
TRUSTED_PROXY_CIDR=127.0.0.1/32
# Private /24s of the three bridges: frontend = published port (web only), edge = web<->api (internal), backend = everything else
# (internal). EDGE_SUBNET is what the api trusts for X-Forwarded-* (only nginx is on it). Change if they collide with your LAN.
BACKEND_SUBNET=10.213.77.0/24
FRONTEND_SUBNET=10.213.78.0/24
EDGE_SUBNET=10.213.79.0/24

# ---- registration ----------------------------------------------------------------------------------------------------------
# disabled (default): organizations are created by the platform admin only. open: public sign-up form (not for in-house use).
REGISTRATION_MODE=disabled
# OpenAPI/Scalar documentation endpoints; keep false in production.
API_DOCS_ENABLED=false

# ---- database secrets (generate-secrets fills these) ---------------------------------------------------------------------
# postgres superuser: used only by the db-init job and by backup/restore. crm_owner: migrator (DDL). crm_app: api + worker (DML only).
POSTGRES_PASSWORD=
CRM_OWNER_PASSWORD=
CRM_APP_PASSWORD=
# Conductor's own role (owns only the "conductor" database).
CONDUCTOR_DB_PASSWORD=

# ---- files (relative to deploy/) ----------------------------------------------------------------------------------------------
# RSA private key (PEM) for JWT signing and the one-time password file of the first platform admin. Both live in deploy/secrets/.
# The password file is 0600 (owner only) and is mounted read-write into the migrator, which empties it after a successful
# create-platform-admin; because of the 0600 mode that command must run as root in the container (--user root, see the runbook).
JWT_SIGNING_KEY_FILE=./secrets/jwt-signing-key.pem
PLATFORM_ADMIN_PASSWORD_FILE=./secrets/platform-admin-password

# ---- first platform admin (used by: docker compose run --rm migrator create-platform-admin) ---------------------------------
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ORG_NAME=Platform

# ---- optional Redis (HybridCache L2; only for more than one api replica) ---------------------------------------------------
# Enable with COMPOSE_PROFILES=redis and REDIS_CONNECTION=redis:6379,password=<REDIS_PASSWORD>
REDIS_PASSWORD=
REDIS_CONNECTION=
REDIS_MAXMEMORY=256mb

# ---- resource limits (placeholders: size them for the pilot; defaults suit ~50 concurrent users) --------------------------
PG_MEM_LIMIT=2g
PG_CPUS=2.0
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=200
PG_LOG_MIN_DURATION_MS=1000
CONDUCTOR_MEM_LIMIT=1536m
CONDUCTOR_CPUS=1.5
CONDUCTOR_JAVA_OPTS=-Xms256m -Xmx768m
API_MEM_LIMIT=1g
API_CPUS=2.0
WORKER_MEM_LIMIT=768m
WORKER_CPUS=1.0
WEB_MEM_LIMIT=128m
WEB_CPUS=0.5
REDIS_MEM_LIMIT=384m
