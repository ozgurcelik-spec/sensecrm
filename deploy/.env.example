# CRM production stack - environment template. Copy to deploy/.env (it is git-ignored) and fill in the blanks, or let
# deploy/generate-secrets.ps1 (Windows PowerShell 5.1+) / deploy/generate-secrets.sh (Linux) do it.
#
# Blank secrets are intentional: docker-compose.prod.yml refuses to start while one is empty, so a copied template can never run
# with a well-known password. Do NOT put quotes, ';' or spaces into passwords (they are embedded in connection strings);
# the generators produce 32 alphanumeric characters.

# ---- identity of the installation ----------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=crm-prod
# Public host name(s) of the SPA as users type it (';' separated). The API rejects other Host headers.
ALLOWED_HOSTS=crm.example.local
# Image tag to run (crm-api|crm-worker|crm-migrator|crm-web:<CRM_VERSION>); CRM_REGISTRY is a prefix incl. trailing slash, e.g. registry.company.local/crm/
CRM_VERSION=latest
CRM_REGISTRY=

# ---- published port (the ONLY one) ---------------------------------------------------------------------------------------
# 127.0.0.1 = a reverse proxy / TLS terminator on the same host. Use the host's private IP (or 0.0.0.0 behind a firewall) when the
# load balancer runs on another machine.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Addresses whose X-Forwarded-For header nginx trusts to learn the real client IP (rate limits, audit trail). Default = the frontend
# network, which covers a proxy on the same host. Set the LB's address/CIDR when it runs elsewhere.
TRUSTED_PROXY_CIDR=10.213.78.0/24
BACKEND_SUBNET=10.213.77.0/24
FRONTEND_SUBNET=10.213.78.0/24

# ---- registration ----------------------------------------------------------------------------------------------------------
# disabled (default): organizations are created by the platform admin only. open: public sign-up form (not for in-house use).
REGISTRATION_MODE=disabled
# OpenAPI/Scalar documentation endpoints; keep false in production.
API_DOCS_ENABLED=false

# ---- database secrets (generate-secrets fills these) ---------------------------------------------------------------------
# postgres superuser: used only by the db-init job and by backup/restore. crm_owner: migrator (DDL). crm_app: api + worker (DML only).
POSTGRES_PASSWORD=
CRM_OWNER_PASSWORD=
CRM_APP_PASSWORD=
# Conductor's own role (owns only the "conductor" database).
CONDUCTOR_DB_PASSWORD=

# ---- files (relative to deploy/) ----------------------------------------------------------------------------------------------
# RSA private key (PEM) for JWT signing and the one-time password file of the first platform admin. Both live in deploy/secrets/.
JWT_SIGNING_KEY_FILE=./secrets/jwt-signing-key.pem
PLATFORM_ADMIN_PASSWORD_FILE=./secrets/platform-admin-password

# ---- first platform admin (used by: docker compose run --rm migrator create-platform-admin) ---------------------------------
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ORG_NAME=Platform

# ---- optional Redis (HybridCache L2; only for more than one api replica) ---------------------------------------------------
# Enable with COMPOSE_PROFILES=redis and REDIS_CONNECTION=redis:6379,password=<REDIS_PASSWORD>
REDIS_PASSWORD=
REDIS_CONNECTION=
REDIS_MAXMEMORY=256mb

# ---- resource limits (placeholders: size them for the pilot; defaults suit ~50 concurrent users) --------------------------
PG_MEM_LIMIT=2g
PG_CPUS=2.0
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=200
PG_LOG_MIN_DURATION_MS=1000
CONDUCTOR_MEM_LIMIT=1536m
CONDUCTOR_CPUS=1.5
CONDUCTOR_JAVA_OPTS=-Xms256m -Xmx768m
API_MEM_LIMIT=1g
API_CPUS=2.0
WORKER_MEM_LIMIT=768m
WORKER_CPUS=1.0
WEB_MEM_LIMIT=128m
WEB_CPUS=0.5
REDIS_MEM_LIMIT=384m

# ---- optional observability overlay (docker-compose.observability.yml; C-OPS1, K20) ----------------------------------------------
# Secrets (metrics-bearer-token, grafana-admin-password, pg-monitor-password) are files in deploy/secrets created by generate-secrets.*.
# Grafana is published on 127.0.0.1 ONLY (no bind override on purpose); Prometheus and the exporters are never published.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=http://localhost:3000
# Retention: whichever limit is reached first.
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=5GB
PROM_MEM_LIMIT=512m
PROM_CPUS=0.5
GRAFANA_MEM_LIMIT=512m
GRAFANA_CPUS=0.5

# ---- integrations (M8B): outbound webhooks + API keys ---------------------------------------------------------------------
# The encryption key for webhook secrets is a Docker secret (deploy/secrets/integrations-encryption-key, made by generate-secrets); see INTEGRATIONS_KEY_FILE above.
# Outbound webhooks are OFF by default: nothing leaves the data centre. To enable them, use the egress overlay (deploy/docker-compose.egress.yml):
#   COMPOSE_PROFILES=egress   WEBHOOKS_ENABLED=true   and start with  -f docker-compose.prod.yml -f docker-compose.egress.yml
INTEGRATIONS_KEY_FILE=./secrets/integrations-encryption-key
WEBHOOKS_ENABLED=false
# Upstream resolver used by egress-dns (an internal resolver is recommended: it sees the destination host names). REQUIRED when the egress profile runs.
EGRESS_DNS_UPSTREAM=
# Optional: comma-free host allow-list for webhook targets ("example.com" exact, "*.example.com" sub-domains); empty = any public HTTPS host.
WEBHOOKS_ALLOWED_HOSTS=
# Optional: private CIDRs the operator opens for in-house ERP targets (space separated in the proxy ACL). Loopback/link-local/metadata can never be opened.
WEBHOOKS_ALLOWED_PRIVATE_CIDRS=
EGRESS_DNS_IP=10.213.77.53
EGRESS_PROXY_IP=10.213.77.54
EGRESS_SUBNET=10.213.79.0/24
