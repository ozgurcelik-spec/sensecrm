# TLS termination with a host-level nginx (or the equivalent on HAProxy / F5 / your load balancer).
# The web container (deploy/docker-compose.prod.yml) listens on 127.0.0.1:8080 and speaks plain HTTP.
# The proxy MUST send X-Forwarded-For and X-Forwarded-Proto; the web container trusts them only from TRUSTED_PROXY_CIDR (deploy/.env).

server {
    listen 80;
    server_name crm.company.local;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name crm.company.local;

    ssl_certificate     /etc/ssl/crm/crm.company.local.crt;   # issued by your internal CA
    ssl_certificate_key /etc/ssl/crm/crm.company.local.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
