{
  "ConnectionStrings": {
    "Database": "",
    "Redis": ""
  },
  "Application": { "Name": "Sense.Crm.Api" },
  "Auth": {
    "Issuer": "crm",
    "Audience": "crm-api",
    "KeyId": "",
    "ClockSkewSeconds": 30
  },
  "Identity": {
    "MaxFailedAccessAttempts": 10,
    "LockoutMinutes": 15,
    "MinPasswordLength": 10,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshFamilyDays": 30,
    "RefreshReuseGraceSeconds": 10,
    "LoginThrottleMaxFailures": 5,
    "LoginThrottleWindowMinutes": 15,
    "PasswordHashIterations": 210000,
    "DefaultTimeZone": "Europe/Istanbul"
  },
  "Localization": {
    "DefaultCulture": "tr-TR",
    "SupportedCultures": [ "tr-TR", "en-US" ],
    "ResourcesPath": "Resources"
  },
  "Cors": { "AllowedOrigins": [] },
  "Registration": { "Mode": "" },
  "ForwardedHeaders": { "Enabled": false, "KnownProxies": [], "KnownNetworks": [] },
  "Docs": { "Enabled": false },
  "Paging": { "DefaultPageSize": 25, "MaxPageSize": 100 },
  "Caching": { "DefaultExpirationMinutes": 5, "LocalExpirationSeconds": 30, "KeyPrefixGlobal": "global" },
  "Platform": {
    "Signup": { "PlanCode": "starter" },
    "Provisioning": { "DefaultPlanCode": "internal" },
    "Entitlements": { "CacheSeconds": 30 },
    "Usage": { "CacheSeconds": 300, "SnapshotPollMinutes": 30, "RetentionDays": 400 },
    "Audit": { "RetentionDays": 1825 },
    "Deletion": { "RetentionDays": 30, "MinRetentionDays": 7, "MaxRetentionDays": 90, "PollMinutes": 10, "MaxAttempts": 10, "ChunkSize": 10000 },
    "Plans": [
      {
        "code": "internal", "name": "İç kullanım", "sortOrder": 0, "trialDays": null,
        "limits": { "maxUsers": null, "maxRecords": {} },
        "modules": { "workflows": true, "commerce": true, "service": true, "marketing": true }
      },
      {
        "code": "starter", "name": "Starter", "sortOrder": 10, "trialDays": 14,
        "limits": { "maxUsers": 5, "maxRecords": { "sales": 5000, "activities": 10000 } },
        "modules": { "workflows": false, "commerce": false, "service": false, "marketing": false }
      },
      {
        "code": "business", "name": "Business", "sortOrder": 20, "trialDays": 14,
        "limits": { "maxUsers": 25, "maxRecords": { "sales": 100000, "activities": 200000, "commerce": 50000, "service": 50000, "marketing": 20000, "workflows": 50 } },
        "modules": { "workflows": true, "commerce": true, "service": true, "marketing": false }
      },
      {
        "code": "enterprise", "name": "Enterprise", "sortOrder": 30, "trialDays": null,
        "limits": { "maxUsers": 250, "maxRecords": {} },
        "modules": { "workflows": true, "commerce": true, "service": true, "marketing": true }
      }
    ]
  },
  "Conductor": { "BaseUrl": "", "RequestTimeoutSeconds": 15 },
  "Outbox": { "BatchSize": 50, "MaxAttempts": 10, "BaseBackoffSeconds": 5, "MaxBackoffSeconds": 3600, "PollingIntervalSeconds": 2 },
  "Diagnostics": { "SlowRequestThresholdMs": 500 },
  "RateLimiting": {
    "Auth": { "PermitLimit": 20, "WindowSeconds": 60, "QueueLimit": 0 },
    "User": { "PermitLimit": 600, "WindowSeconds": 60, "QueueLimit": 0 },
    "Tenant": { "PermitLimit": 3000, "WindowSeconds": 60, "QueueLimit": 0 },
    "LoginEmail": { "PermitLimit": 20, "WindowSeconds": 60, "QueueLimit": 0 }
  },
  "RequestLimits": { "MaxRequestBodyBytes": 1048576 },
  "ProblemDetails": { "TypeBaseUrl": "https://errors.crm.local/", "IncludeExceptionDetails": false },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [ { "Name": "Console" } ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
