{
  "name": "crm_lead_assignment",
  "description": "CRM v1: yeni potansiyel musteriyi rolun uyeleri arasinda round-robin atar ve takip gorevi acar. Gorevler yalniz tenantId+executionId ile yurutmeyi bulur; rol/parametre kayitli kuraldan okunur (Conductor girdisi guvenilmez).",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "crm@algosense.com.tr",
  "restartable": true,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 0,
  "inputParameters": ["tenantId", "executionId", "ruleId", "leadId", "leadName"],
  "tasks": [
    {
      "name": "crm_assign_lead_owner",
      "taskReferenceName": "assign_owner",
      "type": "SIMPLE",
      "inputParameters": {
        "tenantId": "${workflow.input.tenantId}",
        "executionId": "${workflow.input.executionId}"
      }
    },
    {
      "name": "crm_create_followup_task",
      "taskReferenceName": "create_followup",
      "type": "SIMPLE",
      "inputParameters": {
        "tenantId": "${workflow.input.tenantId}",
        "executionId": "${workflow.input.executionId}",
        "ownerUserId": "${assign_owner.output.ownerUserId}"
      }
    }
  ]
}
